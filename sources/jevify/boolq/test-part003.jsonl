{"id": "boolq/test/214", "source": "boolq", "primitive": "noul", "split": "test", "state": "{\"passage\": \"It is illegal to sell packaged liquor (off-premises sales) on Sundays. Sales also are prohibited on Memorial Day, Independence Day, Labor Day, Thanksgiving Day, and Christmas Day. Low-point beer for consumption off-premises may not be sold between 2:00 a.m. and 6:00 a.m.\", \"question\": \"are liquor stores open on memorial day oklahoma\"}", "question": "{\"type\": \"noul\", \"instructions\": \"Based only on `passage`, is the answer to `question` yes?\"}", "label": "0", "soft_label": null, "meta": "{\"hf_id\": \"google/boolq\", \"license\": \"cc-by-sa-3.0\", \"domain\": \"reading-comprehension\", \"task_family\": \"grounded-yes-no\", \"hf_config\": \"default\"}"}
