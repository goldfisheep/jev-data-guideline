{"id": "boolq/test/1184", "source": "boolq", "primitive": "noul", "split": "test", "state": "{\"passage\": \"Elmendorf Air Force Base (IATA: EDF, ICAO: PAED, FAA LID: EDF) is a United States military facility in Anchorage, the largest city in Alaska. Originally known as Elmendorf Field, it became Elmendorf Air Force Base after World War II, and in 2010 it merged with nearby Fort Richardson to form Joint Base Elmendorf-Richardson.\", \"question\": \"is there an air force base in anchorage alaska\"}", "question": "{\"type\": \"noul\", \"instructions\": \"Based only on `passage`, is the answer to `question` yes?\"}", "label": "1", "soft_label": null, "meta": "{\"hf_id\": \"google/boolq\", \"license\": \"cc-by-sa-3.0\", \"domain\": \"reading-comprehension\", \"task_family\": \"grounded-yes-no\", \"hf_config\": \"default\"}"}
