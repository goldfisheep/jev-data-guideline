{"id": "arc_challenge/test/680", "source": "arc_challenge", "primitive": "choice", "split": "test", "state": "{\"question\": \"Phillip was making hot tea. When he poured the hot water into a glass, the glass broke. Which is the most likely reason the glass broke?\"}", "question": "{\"type\": \"choice\", \"instructions\": \"Which option is the correct answer to `question`?\", \"criteria\": {\"A\": \"the hot water was poured in too slowly\", \"B\": \"the hot water evaporated too slowly\", \"C\": \"the glass contracted too quickly\", \"D\": \"the glass expanded too rapidly\"}}", "label": "D", "soft_label": null, "meta": "{\"hf_id\": \"allenai/ai2_arc\", \"license\": \"cc-by-sa-4.0\", \"domain\": \"knowledge\", \"task_family\": \"mcq\", \"hf_config\": \"ARC-Challenge\", \"arc_id\": \"Mercury_7159215\"}"}
