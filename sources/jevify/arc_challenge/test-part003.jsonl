{"id": "arc_challenge/test/724", "source": "arc_challenge", "primitive": "choice", "split": "test", "state": "{\"question\": \"The main disadvantage of using solar energy to generate electricity is that solar panels\"}", "question": "{\"type\": \"choice\", \"instructions\": \"Which option is the correct answer to `question`?\", \"criteria\": {\"A\": \"produce greenhouse gases.\", \"B\": \"produce water pollution.\", \"C\": \"are expensive to operate.\", \"D\": \"are expensive to purchase.\"}}", "label": "D", "soft_label": null, "meta": "{\"hf_id\": \"allenai/ai2_arc\", \"license\": \"cc-by-sa-4.0\", \"domain\": \"knowledge\", \"task_family\": \"mcq\", \"hf_config\": \"ARC-Challenge\", \"arc_id\": \"Mercury_7213325\"}"}
{"id": "arc_challenge/test/674", "source": "arc_challenge", "primitive": "choice", "split": "test", "state": "{\"question\": \"Which two plant cell structures are responsible for storing energy from sunlight and later releasing it for cells to use?\"}", "question": "{\"type\": \"choice\", \"instructions\": \"Which option is the correct answer to `question`?\", \"criteria\": {\"A\": \"chloroplast and mitochondrion\", \"B\": \"mitochondrion and cell wall\", \"C\": \"chloroplast and nucleus\", \"D\": \"nucleus and cell wall\"}}", "label": "A", "soft_label": null, "meta": "{\"hf_id\": \"allenai/ai2_arc\", \"license\": \"cc-by-sa-4.0\", \"domain\": \"knowledge\", \"task_family\": \"mcq\", \"hf_config\": \"ARC-Challenge\", \"arc_id\": \"OHAT_2010_8_35\"}"}
{"id": "arc_challenge/test/1000", "source": "arc_challenge", "primitive": "choice", "split": "test", "state": "{\"question\": \"In a population of brown snakes, a snake is born with a white-spotted pattern. Which factor will have the most influence on whether this trait will become common in the brown snake population?\"}", "question": "{\"type\": \"choice\", \"instructions\": \"Which option is the correct answer to `question`?\", \"criteria\": {\"A\": \"the ability of the snake to survive to reproduce\", \"B\": \"the appearance of other new traits in the baby snake\", \"C\": \"the history of the pattern in previous snake populations\", \"D\": \"the presence of thermal energy changing the snake pattern\"}}", "label": "A", "soft_label": null, "meta": "{\"hf_id\": \"allenai/ai2_arc\", \"license\": \"cc-by-sa-4.0\", \"domain\": \"knowledge\", \"task_family\": \"mcq\", \"hf_config\": \"ARC-Challenge\", \"arc_id\": \"Mercury_7172270\"}"}
