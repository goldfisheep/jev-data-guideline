{"id": "arc_challenge/test/391", "source": "arc_challenge", "primitive": "choice", "split": "test", "state": "{\"question\": \"Nutrient-laden waters from heavy rains flow into the Gulf of Mexico. This produces an algae bloom in the ocean environment. As the algae decays, it uses up large amounts of oxygen along the coastline. Which would most likely happen to the area as a result?\"}", "question": "{\"type\": \"choice\", \"instructions\": \"Which option is the correct answer to `question`?\", \"criteria\": {\"A\": \"Nitrogen replaces oxygen in the water.\", \"B\": \"The temperature of the water increases.\", \"C\": \"Wave action carries away the dead algae.\", \"D\": \"Bottom dwellers die and fish swim away.\"}}", "label": "D", "soft_label": null, "meta": "{\"hf_id\": \"allenai/ai2_arc\", \"license\": \"cc-by-sa-4.0\", \"domain\": \"knowledge\", \"task_family\": \"mcq\", \"hf_config\": \"ARC-Challenge\", \"arc_id\": \"Mercury_7168823\"}"}
