{"id": "strategyqa_grounded/test/354", "source": "strategyqa_grounded", "primitive": "noul", "split": "test", "state": "{\"facts\": \"Silicon is a key material for the production of semiconductor chips. A silicon shortage would mean fewer semiconductor chips could be produced. A business that produces fewer products than normal will receive lower than normal revenue.\", \"question\": \"Would a silicon shortage be bad for Intel's sales?\"}", "question": "{\"type\": \"noul\", \"instructions\": \"Given `facts`, is the answer to `question` yes?\"}", "label": "1", "soft_label": null, "meta": "{\"hf_id\": \"ChilleD/StrategyQA\", \"license\": \"mit\", \"domain\": \"knowledge\", \"task_family\": \"grounded-yes-no\", \"qid\": \"e1f6fead3b0070fe2142\", \"term\": \"Intel\"}"}
{"id": "strategyqa_grounded/test/419", "source": "strategyqa_grounded", "primitive": "noul", "split": "test", "state": "{\"facts\": \"Pitman shorthand was invented in 1837. The tenth Amendment to the Constitution was added in 1791.\", \"question\": \"Was the tenth Amendment to the Constitution written using Pitman shorthand?\"}", "question": "{\"type\": \"noul\", \"instructions\": \"Given `facts`, is the answer to `question` yes?\"}", "label": "0", "soft_label": null, "meta": "{\"hf_id\": \"ChilleD/StrategyQA\", \"license\": \"mit\", \"domain\": \"knowledge\", \"task_family\": \"grounded-yes-no\", \"qid\": \"127e33dd84829d6283ef\", \"term\": \"Tenth Amendment to the United States Constitution\"}"}
{"id": "strategyqa_grounded/test/463", "source": "strategyqa_grounded", "primitive": "noul", "split": "test", "state": "{\"facts\": \"Kindergartners are usually between 4 and 6 years of age. Kindergartners are tasked with learning the alphabet and how to write their own names.\", \"question\": \"Would a thesis paper be unusual to assign to kindergartners? \"}", "question": "{\"type\": \"noul\", \"instructions\": \"Given `facts`, is the answer to `question` yes?\"}", "label": "1", "soft_label": null, "meta": "{\"hf_id\": \"ChilleD/StrategyQA\", \"license\": \"mit\", \"domain\": \"knowledge\", \"task_family\": \"grounded-yes-no\", \"qid\": \"1331f2020fafcdb794c6\", \"term\": \"Thesis\"}"}
{"id": "strategyqa_grounded/test/130", "source": "strategyqa_grounded", "primitive": "noul", "split": "test", "state": "{\"facts\": \"Phileas Fogg is a character in Jules Verne's Around the World in Eighty Days. Phileas Fogg attempts to circumnavigate the globe in 80 days. Pope John Paul I reigned for only 33 days.\", \"question\": \"Phileas Fogg's around the world would be difficult to achieve during Pope John Paul I's reign?\"}", "question": "{\"type\": \"noul\", \"instructions\": \"Given `facts`, is the answer to `question` yes?\"}", "label": "1", "soft_label": null, "meta": "{\"hf_id\": \"ChilleD/StrategyQA\", \"license\": \"mit\", \"domain\": \"knowledge\", \"task_family\": \"grounded-yes-no\", \"qid\": \"9fe0a73c0db0f034f859\", \"term\": \"Pope John Paul I\"}"}
{"id": "strategyqa_grounded/test/286", "source": "strategyqa_grounded", "primitive": "noul", "split": "test", "state": "{\"facts\": \"Binary options tend to have 2 instead of 10 as a base.  Binary directly describes something composed of 2 things. \", \"question\": \"Could boolean algebra be described as binary?\"}", "question": "{\"type\": \"noul\", \"instructions\": \"Given `facts`, is the answer to `question` yes?\"}", "label": "1", "soft_label": null, "meta": "{\"hf_id\": \"ChilleD/StrategyQA\", \"license\": \"mit\", \"domain\": \"knowledge\", \"task_family\": \"grounded-yes-no\", \"qid\": \"6330413d518d44e68b94\", \"term\": \"Boolean algebra\"}"}
{"id": "strategyqa_grounded/test/647", "source": "strategyqa_grounded", "primitive": "noul", "split": "test", "state": "{\"facts\": \"Aldi cuts costs by charging for bags, buying in bulk, and by avoiding brand name items.  Aldi removes spoiled or expired foods from their shelves immediately upon identification.\", \"question\": \"Are Aldi's foods discounted due to being out of date?\"}", "question": "{\"type\": \"noul\", \"instructions\": \"Given `facts`, is the answer to `question` yes?\"}", "label": "0", "soft_label": null, "meta": "{\"hf_id\": \"ChilleD/StrategyQA\", \"license\": \"mit\", \"domain\": \"knowledge\", \"task_family\": \"grounded-yes-no\", \"qid\": \"b978c4051673fd21035b\", \"term\": \"Aldi\"}"}
{"id": "strategyqa_grounded/test/600", "source": "strategyqa_grounded", "primitive": "noul", "split": "test", "state": "{\"facts\": \"Hair grows from the skin. Skeletons are a structure of multiple bones. Bones do not grow hair. \", \"question\": \"Do skeletons have hair?\"}", "question": "{\"type\": \"noul\", \"instructions\": \"Given `facts`, is the answer to `question` yes?\"}", "label": "0", "soft_label": null, "meta": "{\"hf_id\": \"ChilleD/StrategyQA\", \"license\": \"mit\", \"domain\": \"knowledge\", \"task_family\": \"grounded-yes-no\", \"qid\": \"f4256dffd78da0d7fdf8\", \"term\": \"Hair\"}"}
